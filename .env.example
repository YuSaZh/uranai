# ==============================================================================
# Uranai Tarot Web App — Environment Configuration
# Copy to .env (or .env.local for local dev) and fill in optional credentials.
# ==============================================================================

# Docker host port mapping (default: 3232)
URANAI_PORT=3232

# ------------------------------------------------------------------------------
# AI Reading API (OpenAI-compatible protocol)
# Works with OpenAI, DeepSeek, OpenRouter, Gemini OpenAI endpoint, SiliconFlow, etc.
# Users can also configure their own API key directly inside the Settings page.
# ------------------------------------------------------------------------------
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Supabase (Optional — Cloud Auth & Multi-device History/Preference Sync)
# Leave blank to run in zero-setup local browser storage mode.
# Run supabase/migrations/001_init.sql in your Supabase SQL Editor first.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
